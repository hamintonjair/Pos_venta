# Configuración del Sistema POS
# Copiar este archivo a .env y ajustar los valores según tu entorno

# Entorno (development/production)
APP_ENV=development

# URL Base de la Aplicación
APP_URL=https://vessels-mambo-converted-advertisement.trycloudflare.com/Pos_venta/

# Configuración de Base de Datos
DB_HOST=localhost
DB_NAME=pos_venta_db
DB_USER=root
DB_PASSWORD=
DB_DRIVER=mysql

# Configuración del Servidor
SERVER_NAME=localhost
SERVER_PORT=80
DOCUMENT_ROOT=C:/xampp/htdocs/Pos_venta

# Configuración de Sesiones
SESSION_LIFETIME=7200
SESSION_PATH=/
SESSION_NAME=pos_venta_session

# Configuración de Archivos
UPLOAD_PATH=assets/uploads/
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# Configuración de Correo (opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu-email@gmail.com
MAIL_PASSWORD=tu-contraseña
